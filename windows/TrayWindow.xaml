<Window x:Class="RedMagicMonitor.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedMagicMonitor"
        Title="{local:Tr Key=红魔显示器}" Icon="/Icons/Monitor.ico" Width="400"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#161518"/>
    <SolidColorBrush x:Key="CardBrush" Color="#211F24"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#302C35"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#393540"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F7F3F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B6ACBA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FC647C"/>
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#532631"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#534956"/>

    <Style x:Key="ExportMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="MinWidth" Value="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="3">
              <ItemsPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                  <Border x:Name="Row" Background="Transparent" Padding="8,4" CornerRadius="3">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="UiButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="Tag" Value="selected">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.52"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource UiButton}"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="4,0,0,0">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="19">
                  <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource MutedBrush}" Opacity="0.55"/>
                  </ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LevelSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="15" Height="15">
                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="8" Background="{DynamicResource AccentBrush}"
                              BorderBrush="{DynamicResource PanelBrush}" BorderThickness="1"/>
                    </ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Track" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="3" Padding="18,16,18,14" CornerRadius="15" BorderThickness="1"
          BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource PanelBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="HeaderDrag">
        <StackPanel Margin="0,0,38,0">
          <TextBlock TextWrapping="Wrap" Text="{local:Tr Key=红魔显示器}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="GM001J 4K" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" FontSize="12"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="×" Padding="0" Width="31"
                FontSize="18" AutomationProperties.Name="{local:Tr Key=关闭面板}" Click="HideClicked"/>
      </Grid>

      <Border Grid.Row="1" Margin="0,15,0,0" Padding="3" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
              Background="{DynamicResource CardBrush}" CornerRadius="9">
        <UniformGrid Columns="3">
          <Button x:Name="DdcTab" Margin="0,0,2,0" Content="DDC" Click="SelectDdc"/>
          <Button x:Name="BleTab" Margin="2,0" Content="{local:Tr Key=蓝牙}" Click="SelectBluetooth"/>
          <Button x:Name="DonationTab" Margin="2,0,0,0" Content="{local:Tr Key=捐献}" Click="SelectDonation"/>
        </UniformGrid>
      </Border>

      <DockPanel Grid.Row="2" x:Name="TransportStatus" Margin="2,11,0,11" LastChildFill="True">
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                 Fill="{DynamicResource AccentBrush}"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
      </DockPanel>

      <ScrollViewer Grid.Row="3" x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Top">
          <DockPanel x:Name="InputHeading" Margin="0,0,0,7">
            <Button x:Name="ExportInputShortcut" DockPanel.Dock="Right" Content="{local:Tr Key=导出快捷方式}"
                    MinHeight="26" Padding="8,2" Click="ChooseShortcutInput"/>
            <TextBlock TextWrapping="Wrap" Text="{local:Tr Key=输入源}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel x:Name="DdcPage">
            <UniformGrid x:Name="DdcInputs" Columns="4"/>
            <Border Margin="0,13,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,4">
              <StackPanel x:Name="DdcLevels"/>
            </Border>
            <Button x:Name="ResetDdc" Content="{local:Tr Key=恢复默认}" Margin="0,10,0,0" HorizontalAlignment="Right"
                    ToolTip="{local:Tr Key=将亮度和对比度设为 50}" Click="RestoreDefaults"/>
          </StackPanel>
          <ItemsControl x:Name="DonationCards" Visibility="Collapsed" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Margin="0,0,0,6" Padding="14,7,7,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                      <Border Width="22" Height="3" CornerRadius="1.5" Background="{Binding Accent}"
                              HorizontalAlignment="Left" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="17"/>
                      <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="3">
                      <Image Width="140" Height="140" Source="{Binding ImageUri}" Stretch="Uniform"
                             SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                             AutomationProperties.Name="{Binding AccessibilityName}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="BlePage" Visibility="Collapsed">
            <UniformGrid x:Name="BleInputs" Columns="4"/>
            <TextBlock x:Name="BleInputDetail" TextWrapping="Wrap" FontSize="12" Margin="2,6,2,0"
                       Foreground="{DynamicResource MutedBrush}"/>
            <Border Margin="0,13,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,6">
              <StackPanel x:Name="PictureOptions"/>
            </Border>
            <TextBlock Text="{local:Tr Key=氛围灯}" Margin="0,14,0,7" FontWeight="SemiBold"/>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,6">
              <StackPanel x:Name="LightOptions"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Margin="0,11,0,0">
        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,11"/>
        <DockPanel LastChildFill="False">
          <CheckBox x:Name="Startup" Content="{local:Tr Key=登录时启动}" DockPanel.Dock="Left" Click="ChangeStartup"/>
          <Button x:Name="Disconnect" Content="{local:Tr Key=断开蓝牙}" DockPanel.Dock="Right" Visibility="Hidden" Click="DisconnectClicked"/>
        </DockPanel>
        <UniformGrid Columns="3" Margin="0,10,0,0">
          <Button x:Name="RefreshButton" Content="{local:Tr Key=刷新}" Margin="0,0,4,0" Click="RefreshClicked"/>
          <Button Content="GitHub" ToolTip="{local:Tr Key=在浏览器中打开项目仓库}" Margin="0,0,4,0"
                  Visibility="{Binding Visibility, ElementName=DonationCards}" Click="OpenGitHub"/>
          <Button Content="{local:Tr Key=日志}" Margin="4,0,4,0" Click="OpenLog"/>
          <Button Content="{local:Tr Key=退出}" Margin="4,0,0,0" Click="QuitClicked"/>
        </UniformGrid>
      </StackPanel>
    </Grid>
  </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>RedMagicMonitor</AssemblyName>
    <AssemblyTitle>红魔显示器</AssemblyTitle>
    <Product>红魔显示器 Windows</Product>
    <Version>0.5.4</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icons\Monitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Icons\Monitor.ico" />
    <Resource Include="..\assets\donation\qr\venmo.png" Link="Donation\venmo.png" />
    <Resource Include="..\assets\donation\app\alipay.png" Link="Donation\alipay.png" />
    <Resource Include="..\assets\donation\app\wechat-pay.png" Link="Donation\wechat-pay.png" />
    <EmbeddedResource Include="Icons\TrayBlack.ico" LogicalName="TrayBlack.ico" />
    <EmbeddedResource Include="Icons\TrayWhite.ico" LogicalName="TrayWhite.ico" />
  </ItemGroup>
</Project>

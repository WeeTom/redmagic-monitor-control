<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>RedMagicMonitor</AssemblyName>
    <AssemblyTitle>REDMAGIC Monitor</AssemblyTitle>
    <Product>REDMAGIC Monitor for Windows</Product>
    <Version>1.0.0</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icons\Monitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Locales\*.json" WithCulture="false" LogicalName="Locales.%(Filename).json" />
    <Resource Include="Icons\Monitor.ico" />
    <Resource Include="..\assets\donation\qr\*.png" Link="Donation\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\TrayBlack.ico" LogicalName="TrayBlack.ico" />
    <EmbeddedResource Include="Icons\TrayWhite.ico" LogicalName="TrayWhite.ico" />
  </ItemGroup>
</Project>

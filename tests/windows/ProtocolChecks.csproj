<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TraySource>$(MSBuildThisFileDirectory)..\..\windows</TraySource>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(TraySource)\Locales\*.json" LogicalName="Locales.%(Filename).json" WithCulture="false" />
    <Compile Include="$(TraySource)\MonitorDiscovery.cs" Link="MonitorDiscovery.cs" />
    <Compile Include="$(TraySource)\Localization.cs" Link="Localization.cs" />
    <Compile Include="$(TraySource)\BleProtocol.cs" Link="BleProtocol.cs" />
    <Compile Include="$(TraySource)\MonitorModel.cs" Link="MonitorModel.cs" />
    <Compile Include="$(TraySource)\TypeCReturn.cs" Link="TypeCReturn.cs" />
    <Compile Include="$(TraySource)\ShortcutInputSwitcher.cs" Link="ShortcutInputSwitcher.cs" />
    <Compile Include="$(TraySource)\ShortcutChannel.cs" Link="ShortcutChannel.cs" />
    <Compile Include="$(TraySource)\InputShortcut.cs" Link="InputShortcut.cs" />
    <Compile Include="$(TraySource)\NvDdcVolume.cs" Link="NvDdcVolume.cs" />
    <Compile Include="$(TraySource)\TraySettings.cs" Link="TraySettings.cs" />
  </ItemGroup>
</Project>
